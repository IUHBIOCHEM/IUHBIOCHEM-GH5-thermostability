# OS / editor / python
.DS_Store
__pycache__/
*.pyc
*.tmp
tmp_*

# Failed external tool and its outputs (not part of this work's results)
TemStaPro/
temstapro_run/

# Large derived caches — regenerated by the scripts (see script headers)
*.npy
*.pkl
ai_training/embeddings_all/
ai_training/family_emb/
ai_training/meltome/
ai_training/ogt_esm2/
ai_training/ogt_esm2_650M/
ai_training/ogt_regression/
ai_training/topt_esm2_650M/
ai_training/topt_classifier/
ai_training/plm_bench/
data_meltome/

# FoldX: keep inputs (individual_list*.txt, *.sh, *.fxout, original PDBs);
# exclude repaired PDBs, the proprietary binary and rotabase
foldx_run/*_Repair*.pdb
foldx_run/WT_*.pdb
foldx_run/molecules/
foldx_run/foldx
foldx_run/foldx5*
foldx_run/rotabase.txt
foldx_extract/

# PDB survey set (auto-downloaded): keep only the key structures used in figures
ai_training/structures/*
!ai_training/structures/3AMC.pdb
!ai_training/structures/3PZT.pdb
!ai_training/structures/5X3A.pdb
!ai_training/structures/pdb_org.json

# Manuscript binaries (paper submitted separately); keep manuscript/figures/
manuscript/*.docx
manuscript/*.pdf
manuscript/~$*

# Archives / proprietary binaries (never publish)
*.zip
foldx5_MacSilicon*
trinhtu*

# local render scratch (portable SCRATCH_DIR)
_scratch/
